# ERA Books Online smoke tests -- settings.
# Copy this file to .env.local and fill it in. .env.local is never committed.
# On GitHub Actions, the same names are set as repository secrets/variables.

# ---- Site ---------------------------------------------------------------
# Which ERA Books Online to test. Paths below are relative to it.
# (erabooksonline.com redirects to www., so use www. directly.)
EBO_BASE_URL=https://www.erabooksonline.com

# ---- Library member login ----------------------------------------------
# The library page members sign in on, and the barcode to sign in with.
# Every member check uses this login.
EBO_LIBRARY_PATH=/au-demo/
EBO_BARCODE=

# ---- Staff Access (login & usage reports) --------------------------------
# A staff account's WordPress username and password, for /staff-access.
EBO_STAFF_USERNAME=
EBO_STAFF_PASSWORD=

# ---- Pages to check ------------------------------------------------------
# A collection (with its filter bar).
EBO_COLLECTION_PATH=/collections/picture-books/
# A flipbook book, and a read-along (video) book.
EBO_FLIPBOOK_BOOK_PATH=/books/09-brave-flipbook/
EBO_VIDEO_BOOK_PATH=/books/alien-read-along/
# A book whose sidebar lists activities / a Learning Guide.
EBO_ACTIVITY_BOOK_PATH=/books/09-brave-flipbook/
# An embedded (game) book.
EBO_GAME_BOOK_PATH=/books/3d-dice/
# A video playlist with at least 2 videos.
EBO_PLAYLIST_PATH=/playlists/picture-books-humour/
